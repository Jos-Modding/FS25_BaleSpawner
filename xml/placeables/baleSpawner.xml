<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="baleBuyingStation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/placeable.xsd">
    <storeData>
        <name>$l10n_shopItem_baleSpawner</name>
        <functions>
            <function>$l10n_shopItem_baleSpawner</function>
        </functions>
        <image>$data/placeables/brandless/beeHives/beeHivebaleSpawner/store_beeHivebaleSpawner.dds</image>
        <price>2500</price>
        <dailyUpkeep>0</dailyUpkeep>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>waterTanks</category>
        <brush>
            <type>placeable</type>
            <category>buildings</category>
            <tab>containers</tab>
        </brush>
    </storeData>

    <base>
        <filename>i3d/baleSpawner.i3d</filename>
        <boughtWithFarmland>true</boughtWithFarmland>
        <canBeRenamed>true</canBeRenamed>
        <canBeDeleted>true</canBeDeleted>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>

        <sounds>
            <place template="smallImp"/>
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="1" maxSlope="75" maxEdgeAngle="30" >
        <levelAreas>
            <levelArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01" />
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01"/>
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01"/>
        </updateAreas>
    </ai>

    <triggerMarkers>
        <triggerMarker node="teleportNode" filename="$data/shared/assets/marker/markerIconShopping.i3d" />
    </triggerMarkers>

    <hotspots>
        <hotspot type="SHOP" linkNode="playerTrigger" teleportNode="playerTrigger" />
    </hotspots>

    <vehicleBuyingStation>
        <trigger node="playerTrigger" text="Open" />
        <message bought="Bales bought" />

        <storeItem xmlFilename="xml/objects/bales/buyableSquarebale_drygrass_120.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableSquarebale_drygrass_180.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableSquarebale_drygrass_220.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableSquarebale_drygrass_240.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableSquarebale_grass_120.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableSquarebale_grass_180.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableSquarebale_grass_220.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableSquarebale_grass_240.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableSquarebale_silage_120.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableSquarebale_silage_180.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableSquarebale_silage_220.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableSquarebale_silage_240.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableSquarebale_straw_120.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableSquarebale_straw_180.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableSquarebale_straw_220.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableSquarebale_straw_240.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableRoundbale_drygrass_125.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableRoundbale_drygrass_150.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableRoundbale_drygrass_180.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableRoundbale_grass_125.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableRoundbale_grass_150.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableRoundbale_grass_180.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableRoundbale_silage_125.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableRoundbale_silage_150.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableRoundbale_silage_180.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableRoundbale_straw_125.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableRoundbale_straw_150.xml" price="2500" transportCosts="0" />
        <storeItem xmlFilename="xml/objects/bales/buyableRoundbale_straw_180.xml" price="2500" transportCosts="0" />

        <spawnPlaces>
            <spawnPlace startNode="spawnPlaceStart01" endNode="spawnPlaceEnd01" isInverted="true"/>
            <spawnPlace startNode="spawnPlaceStart02" endNode="spawnPlaceEnd02" isInverted="true"/>
        </spawnPlaces>
    </vehicleBuyingStation>

    <i3dMappings>
        <i3dMapping id="baleSpawner" node="0>" />
        <i3dMapping id="warningStripesSmall" node="0>0|0|0" />
        <i3dMapping id="warningStripesMedium" node="0>0|0|1" />
        <i3dMapping id="warningStripesLarge" node="0>0|0|2" />
        <i3dMapping id="playerTrigger" node="0>1|0" />
        <i3dMapping id="teleportNode" node="0>1|1" />
        <i3dMapping id="clearAreaStart01" node="0>2|0" />
        <i3dMapping id="clearAreaWidth01" node="0>2|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>2|0|1" />
        <i3dMapping id="testAreaStart01" node="0>3|0" />
        <i3dMapping id="testAreaEnd01" node="0>3|0|0" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>4|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>4|0|0" />
        <i3dMapping id="spawnPlaceStart01" node="0>5|0" />
        <i3dMapping id="spawnPlaceEnd01" node="0>5|0|0" />
        <i3dMapping id="spawnPlaceStart02" node="0>5|1" />
        <i3dMapping id="spawnPlaceEnd02" node="0>5|1|0" />
    </i3dMappings>
</placeable>
